mainmenu "LED Application"

menuconfig LED_SUBSYSTEM
    bool "LED Subsystem"
    default y

if LED_SUBSYSTEM

choice BLINK_SLEEP_TIME
    prompt "LED blink sleep time"
    default BLINK_SLEEP_1S

config BLINK_SLEEP_250MS
    bool "250ms"

config BLINK_SLEEP_500MS
    bool "500ms"

config BLINK_SLEEP_1S
    bool "1s (medium)"

config BLINK_SLEEP_2S
    bool "2s"

endchoice

config BLINK_SLEEP_TIME_MS
    int
    default 250 if BLINK_SLEEP_250MS
    default 500 if BLINK_SLEEP_500MS
    default 1000 if BLINK_SLEEP_1S
    default 2000 if BLINK_SLEEP_2S

menuconfig ADVANCED_LED_SETTINGS
    bool "Advanced LED settings"
    default n

if ADVANCED_LED_SETTINGS

config LED_BRIGHTNESS
    int "LED brightness (0-100)"
    range 0 100
    default 100

config LED_FADE_DURATION_MS
    int "LED fade duration (ms)"
    range 0 5000
    default 500

endif

menu "Expert settings"
    visible if ADVANCED_LED_SETTINGS

config LED_DEBUG
    bool "Enable LED debugging"
    default n

config CUSTOM_BLINK_PATTERN
    bool "Custom blink pattern"
    default n

endmenu
# New configuration for heartbeat assignment
config APP_HEARTBEAT_PERIOD_MS
        int "Heartbeat period (ms)"
        default 1000
        range 100 2000

endif

# IMPORTANT:
# Load the complete Zephyr Kconfig tree.
source "Kconfig.zephyr" 
